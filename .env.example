# Copy to .env and fill in real values. .env is gitignored — never commit it.

# From @BotFather (the bot's HTTP API token). Treat as a secret.
BOT_TOKEN=123456789:your-telegram-bot-token-here

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Anyone not listed is silently ignored. Get an ID from @userinfobot.
ALLOWED_USER_IDS=514969470
